<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kutubxona Web Tizimi</title>

    <link rel="stylesheet" href="bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">

        <a class="navbar-brand" href="#">
            📚 Kutubxona
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="menu">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="#home">
                        Bosh sahifa
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#books">
                        Kitoblar
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#contact">
                        Aloqa
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>

<div id="slider" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="kutubxona.jpg" class="d-block w-100" height="400">
        </div>

        <div class="carousel-item">
            <img src="kutubxona.jpg" class="d-block w-100" height="400">
        </div>

    </div>

</div>

<section id="home" class="py-5">

    <div class="container">

        <h1 class="text-center text-primary">
            Elektron Kutubxonaga Xush Kelibsiz
        </h1>

        <p class="lead text-center">
            Kutubxona tizimi orqali kitoblar haqida ma'lumot
            olishingiz mumkin.
        </p>

    </div>

</section>

<section id="books">

<div class="container">

<h2 class="text-center mb-4">
Ommabop Kitoblar
</h2>

<div class="row">

<div class="col-md-3">

<div class="card shadow">

<div class="card-body">

<h5 class="card-title">
O'tkan kunlar
</h5>

<p class="card-text">
Abdulla Qodiriy
</p>

<button class="btn btn-primary">
Batafsil
</button>

</div>

</div>

</div>

<div class="col-md-3">

<div class="card shadow">

<div class="card-body">

<h5 class="card-title">
Kecha va Kunduz
</h5>

<p class="card-text">
Cho'lpon
</p>

<button class="btn btn-primary">
Batafsil
</button>

</div>

</div>

</div>

<div class="col-md-3">

<div class="card shadow">

<div class="card-body">

<h5 class="card-title">
Mehrobdan Chayon
</h5>

<p class="card-text">
A.Qodiriy
</p>

<button class="btn btn-primary">
Batafsil
</button>

</div>

</div>

</div>

</div>

<h2 class="mt-5">
Kitoblar Jadvali
</h2>

<table class="table table-striped table-bordered">

<thead class="table-primary">

<tr>
<th>Kitob</th>
<th>Muallif</th>
<th>Yili</th>
</tr>

</thead>

<tbody>

<tr>
<td>O'tkan kunlar</td>
<td>A.Qodiriy</td>
<td>1926</td>
</tr>

<tr>
<td>Kecha va Kunduz</td>
<td>Cho'lpon</td>
<td>1935</td>
</tr>

</tbody>

</table>

<h2 class="mt-5 text-center">
    Kutubxona Tanishtiruv Videosi
</h2>

<div class="container text-center">

    <video class="img-fluid rounded shadow"
           width="700"
           controls>

        <source src="kutubxona.mp4"
                type="video/mp4">

        

    </video>

</div>

<h2>
Kutubxona Xizmatlari
</h2>

<ul class="list-group">

<li class="list-group-item">
Kitob olish
</li>

<li class="list-group-item">
Kitob qaytarish
</li>

<li class="list-group-item">
Elektron kutubxona
</li>

</ul>

<br>

<div class="dropdown">

<button class="btn btn-success dropdown-toggle"
data-bs-toggle="dropdown">

Kategoriyalar

</button>

<ul class="dropdown-menu">

<li>
<a class="dropdown-item" href="#">
Badiiy
</a>
</li>

<li>
<a class="dropdown-item" href="#">
Ilmiy
</a>
</li>

<li>
<a class="dropdown-item" href="#">
Darsliklar
</a>
</li>

</ul>

</div>

<br>

<button class="btn btn-info"
data-bs-toggle="tooltip"
title="Kutubxona haqida ma'lumot">

Tooltip

</button>

<button class="btn btn-warning"
data-bs-toggle="popover"
title="Kutubxona"
data-bs-content="Elektron kutubxona tizimi">

Popover

</button>

</div>

</section>

<section id="contact" class="py-5">

<div class="container">

<h2>
Aloqa
</h2>

<form>

<input type="text"
class="form-control mb-3"
placeholder="Ismingiz">

<input type="email"
class="form-control mb-3"
placeholder="Email">

<textarea
class="form-control mb-3"
rows="4"
placeholder="Xabaringiz"></textarea>

<button
class="btn btn-primary">

Yuborish

</button>

</form>

</div>

</section>

<script src="bootstrap/bootstrap.bundle.min.js"></script>

<script>
var tooltipTriggerList =
[].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))

tooltipTriggerList.map(function (tooltipTriggerEl) {
return new bootstrap.Tooltip(tooltipTriggerEl)
})

var popoverTriggerList =
[].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))

popoverTriggerList.map(function (popoverTriggerEl) {
return new bootstrap.Popover(popoverTriggerEl)
})
</script>

</body>
</html>
